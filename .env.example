# 백엔드 서버 주소 (next.config.ts의 /backend/* 프록시 대상)
BACKEND_URL=http://localhost:18080

# 공유 이미지와 canonical URL에 사용할 사이트 주소 (프로토콜 포함)
# Vercel에서는 미설정 시 운영 도메인, 그 외에는 http://localhost:3000 사용
# 커스텀 도메인 또는 Vercel 외 배포 시 실제 운영 주소를 설정하세요.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 서비스 문의(/api/inquiry)를 받을 웹훅 주소 (Discord·Slack 웹훅 등)
# 비워 두면 개발 환경에서는 서버 콘솔에만 출력하고, 운영 환경에서는 문의를 받지 않습니다.
# INQUIRY_WEBHOOK_URL=https://discord.com/api/webhooks/...
